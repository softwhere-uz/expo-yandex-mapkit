require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16.4'

# RN 0.87 defaults to a prebuilt React-Core xcframework whose module map trips
# -Wnon-modular-include-in-framework-module errors against Expo SDK 57 pods (yoga headers).
# Build React core from source until Expo SDK 58 aligns with the prebuilt core.
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'

prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'BareYandexMapkit' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(\'expo/bin/autolinking\')',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

  end

  # RN 0.87's pod integration appends the "<Pod>/Swift Compatibility Header" directory to
  # HEADER_SEARCH_PATHS UNQUOTED; the spaces split it into three bogus paths, so pods that
  # import <ExpoModulesCore/ExpoModulesCore-Swift.h> fail with "file not found". Re-quote it in
  # the generated xcconfigs. post_integrate (not post_install) because CocoaPods writes the
  # support files to disk after post_install. Remove once Expo SDK 58 / RN fix the integration.
  post_integrate do |installer|
    Dir.glob(File.join(installer.sandbox.target_support_files_root, '**', '*.xcconfig')).each do |file|
      contents = File.read(file)
      fixed = contents.gsub(
        /(?<!")(\$[({]PODS_CONFIGURATION_BUILD_DIR[)}]\/[A-Za-z0-9_.-]+\/Swift Compatibility Header)(?!")/,
        '"\1"'
      )
      File.write(file, fixed) if fixed != contents
    end
  end
end
