# Exclude all top-level hidden directories by convention
/.*/

# Exclude tarballs generated by `npm pack`
/*.tgz

__mocks__
__tests__

/babel.config.js
/internal/module_scripts/
/android/src/androidTest/
/android/src/test/
/android/build/
/example/
/alias/

# TypeScript incremental build state + internal docs
*.tsbuildinfo
/HANDOVER.md

# Internal CI/dev scripts
/scripts/

# Bare CI fixture is excluded from the npm package
/bare-example/

# README artwork — referenced by absolute URL, not shipped in the tarball
/media/
